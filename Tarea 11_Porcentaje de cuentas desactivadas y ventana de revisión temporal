-- ------------------------------------------------------------------------------
-- 1. Porcentaje de Cuentas Desactivadas
-- Grano: 1 fila de métricas agregadas sobre core.accounts.
-- Se realiza una conversión explícita a NUMERIC para evitar la división entera
-- (la cual truncaría 1 / 5 a 0) y se aplica ROUND para mostrar dos decimales.
-- ------------------------------------------------------------------------------
SELECT 
    COUNT(*) AS total_cuentas,
    COUNT(CASE WHEN is_active = FALSE THEN 1 END) AS cuentas_desactivadas,
    ROUND(
        (COUNT(CASE WHEN is_active = FALSE THEN 1 END)::NUMERIC / COUNT(*)::NUMERIC) * 100, 
        2
    ) AS porcentaje_desactivadas
FROM core.accounts;


-- ------------------------------------------------------------------------------
-- 2. Extensión Temporal de Revisión de Movimientos
-- Grano: 1 fila por evento operativo (4 transacciones).
-- Utiliza un corte estático en 2026-10-01 00:00+00 e intervalo fijo de 15 días.
-- ------------------------------------------------------------------------------
SELECT 
    transaction_id,
    tx_timestamp AS marca_original,
    tx_timestamp + INTERVAL '15 days' AS fecha_revision_agendada,
    AGE('2026-10-01 00:00+00'::TIMESTAMPTZ, tx_timestamp) AS antiguedad_al_corte
FROM core.transactions
WHERE tx_timestamp < '2026-09-10 00:00+00'
ORDER BY 
    tx_timestamp ASC, 
    transaction_id ASC;
