-- ------------------------------------------------------------------------------
-- 1. Control Independiente: Promedio agrupado por cuenta
-- Objetivo: Comprobar matemáticamente la media antes de interpretar el evento.
-- ------------------------------------------------------------------------------
SELECT 
    account_id, 
    AVG(amount) AS promedio_cuenta
FROM core.transactions
GROUP BY account_id;

-- ------------------------------------------------------------------------------
-- 2. Reporte Correlacionado: Movimiento superior al promedio local
-- Objetivo: Evaluar cada fila contra una métrica calculada dinámicamente para 
-- la cuenta específica de esa fila (t1.account_id = t2/t3.account_id).
-- ------------------------------------------------------------------------------
SELECT 
    t1.transaction_id,
    t1.account_id,
    t1.amount AS importe_evento,
    (SELECT AVG(amount) FROM core.transactions t2 WHERE t2.account_id = t1.account_id) AS promedio_cuenta
FROM core.transactions t1
WHERE t1.amount > (
    SELECT AVG(t3.amount)
    FROM core.transactions t3
    WHERE t3.account_id = t1.account_id
)
ORDER BY importe_evento DESC;

-- ------------------------------------------------------------------------------
-- 3. Cuentas sin movimientos mediante NOT EXISTS
-- Objetivo: Retener cuentas que no tienen coincidencia en la tabla transaccional,
-- proyectando explícitamente su estatus de actividad.
-- ------------------------------------------------------------------------------
SELECT 
    a.account_number,
    a.is_active
FROM core.accounts a
WHERE NOT EXISTS (
    SELECT 1 
    FROM core.transactions t 
    WHERE t.account_id = a.account_id
)
ORDER BY a.account_number;
