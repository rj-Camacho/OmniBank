-- ------------------------------------------------------------------------------
-- 1. Comportamiento de AVG frente a valores NULL (Demostración del denominador)
-- Grano: 1 fila de totales resumiendo la muestra temporal construida.
-- ------------------------------------------------------------------------------
WITH muestra_nula AS (
    SELECT 10000.00 AS val UNION ALL
    SELECT 0.00 UNION ALL
    SELECT 0.00 UNION ALL
    SELECT NULL
)
SELECT 
    AVG(val) AS avg_ignora_null_denom_3,
    AVG(COALESCE(val, 0)) AS avg_con_cero_denom_4
FROM muestra_nula;


-- ------------------------------------------------------------------------------
-- 2. Reporte de Actividad de Crédito Activa
-- Grano: 1 fila por cuenta de crédito activa (account_number).
-- Filtro de nivel de fila (WHERE): Aplica sobre el tipo de cuenta y su estado
-- antes de realizar cualquier agrupación de movimientos.
-- Filtro agregado (HAVING): Retiene a quienes no tienen eventos (COUNT = 0) o 
-- a quienes superan el umbral de volumen bruto (SUM >= 300).
-- ------------------------------------------------------------------------------
SELECT 
    a.account_number,
    a.balance AS saldo_almacenado,
    COUNT(t.transaction_id) AS numero_movimientos,
    COALESCE(SUM(t.amount), 0) AS volumen_bruto_registrado
FROM core.accounts a
LEFT JOIN core.transactions t 
    ON a.account_id = t.account_id
WHERE a.account_type = 'CREDIT' 
  AND a.is_active = TRUE
GROUP BY 
    a.account_number,
    a.balance
HAVING COUNT(t.transaction_id) = 0 
    OR SUM(t.amount) >= 300
ORDER BY 
    a.account_number;
