-- ------------------------------------------------------------------------------
-- 1. Cuantificación de la Matriz sin Relaciones (Producto Cartesiano)
-- Grano: Total de combinaciones teóricas sin integridad referencial.
-- Cada combinación representa una tupla (Cliente, Cuenta, Transacción) sin importar
-- si la cuenta pertenece al cliente o si la transacción ocurrió en esa cuenta.
-- ------------------------------------------------------------------------------
SELECT 
    (SELECT COUNT(*) FROM core.customers) AS total_clientes,
    (SELECT COUNT(*) FROM core.accounts) AS total_cuentas,
    (SELECT COUNT(*) FROM core.transactions) AS total_transacciones,
    COUNT(*) AS producto_cartesiano
FROM core.customers
CROSS JOIN core.accounts
CROSS JOIN core.transactions;


-- ------------------------------------------------------------------------------
-- 2. Reporte Relacional Corregido de Movimientos Relevantes
-- Grano: 1 fila por evento transaccional real (monto >= 100 y titular activo).
-- ------------------------------------------------------------------------------
SELECT 
    c.email,
    a.account_number,
    t.transaction_type AS tx_type,
    t.amount,
    t.created_at AS tx_timestamp
FROM core.transactions t
INNER JOIN core.accounts a 
    ON t.account_id = a.account_id
INNER JOIN core.customers c 
    ON a.customer_id = c.customer_id
WHERE c.is_active = TRUE 
  AND t.amount >= 100.00
ORDER BY 
    t.created_at ASC, 
    t.transaction_id ASC;
