-- ------------------------------------------------------------------------------
-- 1. Control de Población de Origen
-- ------------------------------------------------------------------------------
SELECT 'core.accounts' AS fuente, COUNT(*) AS total_filas FROM core.accounts
UNION ALL
SELECT 'core.transactions' AS fuente, COUNT(*) FROM core.transactions;


-- ------------------------------------------------------------------------------
-- 2. Reporte de Cuentas: Transformaciones de Texto y Etiquetas
-- Grano: 1 fila por cuenta registrada.
-- ------------------------------------------------------------------------------
SELECT 
    c.email,
    a.account_number,
    a.is_active,
    -- Función de texto: Mayúsculas en nombre completo concatenado con últimos 4 dígitos
    UPPER(c.first_name || ' ' || c.last_name) || ' - ' || RIGHT(a.account_number, 4) AS etiqueta_presentacion
FROM core.accounts a
INNER JOIN core.customers c 
    ON a.customer_id = c.customer_id
ORDER BY 
    a.account_number ASC;


-- ------------------------------------------------------------------------------
-- 3. Reporte de Movimientos: Aritmética de Fechas (Intervalos) y Presentación Numérica
-- Grano: 1 fila por evento operativo antes del corte temporal de seguridad.
-- ------------------------------------------------------------------------------
SELECT 
    transaction_id,
    amount AS importe_original,
    -- Transformación escalar para presentación financiera
    TO_CHAR(amount, 'FM$999,999,999.00') AS importe_formateado,
    -- Extracción escalar de año y mes
    EXTRACT(YEAR FROM tx_timestamp) AS anio_operacion,
    EXTRACT(MONTH FROM tx_timestamp) AS mes_operacion,
    tx_timestamp AS marca_original,
    -- Suma determinista de un intervalo fijo (15 días)
    tx_timestamp + INTERVAL '15 days' AS fecha_revision_agendada,
    -- Diferencia calculada hacia una fecha de corte estática y reproducible
    AGE('2026-10-01 00:00+00'::TIMESTAMPTZ, tx_timestamp) AS antiguedad_al_corte
FROM core.transactions
WHERE tx_timestamp < '2026-09-10 00:00+00'
ORDER BY 
    tx_timestamp ASC, 
    transaction_id ASC;
